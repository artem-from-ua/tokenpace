{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh release create*)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/release-notes-guard.sh\""
          }
        ]
      }
    ]
  }
}
