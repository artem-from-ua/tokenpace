#!/bin/bash

# Swift **build** gate — runs only when the commit touches Swift code, so doc-only or config-only
# commits stay fast. Set TOKENPACE_SKIP_SWIFT_HOOK=1 to bypass (e.g. an intentional WIP commit).
#
# Build only, deliberately. `swift test` ran here too until the pair was measured at ~31 s on a warm
# cache (6 s build, 25 s tests) — far enough past the point where a hook stops being worth its wait
# that the whole gate ended up deleted from a working copy rather than tolerated. A gate that gets
# removed protects nothing; six seconds is a gate that survives.
#
# The half that stayed is the half worth blocking on: code that does not compile is never an
# acceptable commit. A failing *test* sometimes is — a deliberate WIP, a behaviour mid-change — and
# that is exactly why blocking on it grated.
#
# The gap is real and named: logic regressions that compile fine reach `main` unchallenged. That is
# CI's job, not a pre-commit hook's; until this repo has one, `swift test` before opening a PR is
# the manual half of the bargain (CLAUDE.md asks for it in the verification loop anyway).
SWIFT_STAGED=$(git diff --cached --name-only --diff-filter=ACM -- '*.swift' 'Package.swift' 'Package.resolved')

if [ -n "$SWIFT_STAGED" ] && [ "$TOKENPACE_SKIP_SWIFT_HOOK" != "1" ]; then
    if command -v swift >/dev/null 2>&1; then
        echo "Swift sources changed — running swift build…"
        # On macOS 27 a bare `swift build` fails on every SwiftUI `@State`: the macro's plugin ships
        # only inside Xcode.app. The helper prints the `--sdk` override that avoids it, and nothing at
        # all where the default SDK works — so this stays a plain `swift build` on macOS 15/26.
        # Unquoted on purpose: the output is two words (or none), and quoting would pass an empty
        # argument that `swift build` rejects.
        SDK_FLAGS=$("$(git rev-parse --show-toplevel)/scripts/swift-sdk-flags.sh")
        # shellcheck disable=SC2086
        if ! swift build $SDK_FLAGS; then
            echo ""
            echo "Commit blocked: swift build failed."
            echo "  Bypass (WIP only): TOKENPACE_SKIP_SWIFT_HOOK=1 git commit …"
            exit 1
        fi
    else
        echo "warning: swift not found on PATH — skipping build gate." >&2
    fi
fi

# Documentation link gate — runs only when the commit touches markdown, so code-only commits stay
# fast. Set TOKENPACE_SKIP_DOC_LINKS_HOOK=1 to bypass (e.g. an intentional WIP commit).
#
# Anchors are derived from heading *text*, so renaming a heading silently orphans every link
# pointing at it — in files this commit never touched, and with nothing in `git status` to show for
# it. That is why the check runs over the whole corpus rather than only the staged files: the
# damage from a staged rename lands somewhere else. Pure Python over ~150 files costs a fraction of
# a second, nowhere near the ~31 s that got `swift test` removed from this hook.
DOC_STAGED_MD=$(git diff --cached --name-only --diff-filter=ACM -- '*.md')

if [ -n "$DOC_STAGED_MD" ] && [ "$TOKENPACE_SKIP_DOC_LINKS_HOOK" != "1" ]; then
    DOC_LINK_CHECKER="$(git rev-parse --show-toplevel)/scripts/check-doc-links.py"
    if [ -f "$DOC_LINK_CHECKER" ]; then
        echo "Markdown changed — checking documentation links…"
        if ! python3 "$DOC_LINK_CHECKER"; then
            echo ""
            echo "Commit blocked: broken documentation links."
            echo "  Bypass (WIP only): TOKENPACE_SKIP_DOC_LINKS_HOOK=1 git commit …"
            exit 1
        fi
    fi
fi

